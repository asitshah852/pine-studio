# Copy to .env.local (on a computer) or add in Vercel → Settings → Environment Variables.
# Never commit real keys.

# Research, textbook extraction and fact-checking (console.anthropic.com → API keys)
ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-opus-5-5

# Shared saving across devices: Vercel → Storage → Upstash Redis adds these automatically
KV_REST_API_URL=
KV_REST_API_TOKEN=

# Studio passcode: needed to save and use Claude (choose any phrase)
APP_PASSCODE=

# Optional: email each Feedback note (resend.com)
RESEND_API_KEY=
FEEDBACK_EMAIL_TO=
FEEDBACK_EMAIL_FROM=
